{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 100, "aggregationMethod": "median-run" }
        ],
        "resource-summary:script:size": ["error", { "maxNumericValue": 20480 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 256000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
