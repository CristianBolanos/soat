---
/** Páginas secundarias (legales, 404): header y pie con anclas hacia la portada. */
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import MobileCtaBar from '@/components/layout/MobileCtaBar.astro';
import Container from '@/components/ui/Container.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  noindex?: boolean;
}

const { title, description, heading, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Header base="/" />
  <main id="contenido">
    <Container class="py-12 sm:py-16">
      <article class="legal max-w-3xl">
        <h1 class="text-display-sm font-extrabold">{heading}</h1>
        <slot />
      </article>
    </Container>
  </main>
  <Footer base="/" />
  <MobileCtaBar />
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-top: 0.75rem;
    color: var(--text-muted);
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li) {
    margin-top: 0.375rem;
  }
  .legal :global(strong) {
    color: var(--text);
  }
  .legal :global(a) {
    color: var(--brand);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
