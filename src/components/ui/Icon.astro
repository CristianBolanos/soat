---
/**
 * Ícono SVG en línea, resuelto al compilar (cero JS y cero fuentes de íconos).
 * `name`: un ícono de Lucide ("phone") o de Simple Icons ("simple-icons:whatsapp").
 * Sin `label` es decorativo (aria-hidden); con `label` se anuncia como imagen.
 */
import { icons as lucide } from '@iconify-json/lucide';
import { icons as simpleIcons } from '@iconify-json/simple-icons';
import { getIconData, iconToSVG } from '@iconify/utils';

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
const SIMPLE = 'simple-icons:';
const isSimple = name.startsWith(SIMPLE);
const data = getIconData(
  isSimple ? simpleIcons : lucide,
  isSimple ? name.slice(SIMPLE.length) : name,
);
if (!data) throw new Error(`Ícono no encontrado: ${name}`);
const { attributes, body } = iconToSVG(data);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={attributes.viewBox}
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
