---
/**
 * Sección de la landing con título accesible. `tone="surface"` alterna el fondo
 * para separar bloques sin líneas. El `id` mantiene las anclas del sitio anterior.
 */
import Container from './Container.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'surface';
  class?: string;
}

const { id, title, intro, tone = 'default', class: className } = Astro.props;
const headingId = `${id}-titulo`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['py-14 sm:py-20', tone === 'surface' && 'bg-surface', className]}
>
  <Container>
    <h2 id={headingId} class="text-title sm:text-title-lg font-extrabold">
      {title}
    </h2>
    {intro && <p class="text-lead mt-3 max-w-2xl text-muted">{intro}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </Container>
</section>
