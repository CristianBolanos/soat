---
/**
 * Cómo evitar un SOAT falso (#verificacion, con #antifraude dentro): el miedo número uno
 * del cliente es el SOAT falso. Por eso es la única franja navy de la página, con una
 * señal preventiva amarilla (lenguaje que todo conductor reconoce) y una lista de
 * verificación en lugar de tarjetas. La verificación en el RUNT es argumento de venta.
 */
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import { safetySection, safetyTips } from '@/data/landing';
---

<Section
  id="verificacion"
  estimate="[contain-intrinsic-size:auto_880px] sm:[contain-intrinsic-size:auto_830px] lg:[contain-intrinsic-size:auto_610px]"
  tone="alert"
  class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-x-18"
>
  <SectionHeading id="verificacion" title={safetySection.title} intro={safetySection.intro}>
    <svg
      slot="before"
      viewBox="0 0 100 100"
      class="mb-5 size-16 sm:size-21"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="17"
        y="17"
        width="66"
        height="66"
        rx="7"
        transform="rotate(45 50 50)"
        class="fill-cta"
      ></rect>
      <rect
        x="22"
        y="22"
        width="56"
        height="56"
        rx="4"
        transform="rotate(45 50 50)"
        fill="none"
        stroke-width="3.5"
        class="stroke-on-cta"
      ></rect>
      <rect x="45.5" y="29" width="9" height="29" rx="3.5" class="fill-on-cta"></rect>
      <circle cx="50" cy="68.5" r="5" class="fill-on-cta"></circle>
    </svg>
  </SectionHeading>
  <div>
    <ul id="antifraude" class="border-t border-line">
      {safetyTips.map((tip) => (
        <li class="flex gap-3.5 border-b border-line py-4.5">
          <svg
            viewBox="0 0 24 24"
            class="mt-0.5 size-6 shrink-0"
            aria-hidden="true"
            focusable="false"
          >
            <rect width="24" height="24" rx="6" class="fill-cta" />
            <path
              d="M6.5 12.5l3.5 3.5 7.5-8"
              fill="none"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-on-cta"
            />
          </svg>
          <div>
            <h3 class="text-[1.0625rem] font-extrabold">{tip.title}</h3>
            <p class="mt-1 text-muted">{tip.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-7">
      <Button
        href={site.links.runt}
        variant="outline"
        size="lg-long"
        icon="search-check"
        external
        data-track="runt_click"
      >
        Verificar mi SOAT en el RUNT
      </Button>
    </div>
  </div>
</Section>
