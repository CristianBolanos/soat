---
/**
 * Compra segura (#verificacion, con #antifraude dentro): el miedo número uno del
 * cliente es el SOAT falso, así que la verificación en el RUNT es argumento de venta.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import { safetyTips } from '@/data/landing';
---

<Section
  id="verificacion"
  title="Compra segura: evita el SOAT falso"
  intro="Cada año aparecen ofertas de SOAT falso. Con estos tres consejos compras con tranquilidad."
>
  <ul id="antifraude" class="grid gap-4 sm:grid-cols-3">
    {safetyTips.map((tip) => (
      <li class="rounded-card border border-line bg-bg p-5">
        <Icon name={tip.icon} class="size-6 text-brand" />
        <h3 class="mt-3 font-bold">{tip.title}</h3>
        <p class="mt-1 text-sm text-muted">{tip.text}</p>
      </li>
    ))}
  </ul>
  <div class="mt-8">
    <Button
      href={site.links.runt}
      variant="outline"
      size="lg"
      icon="search-check"
      external
      data-track="runt_click"
    >
      Verificar mi SOAT en el RUNT
    </Button>
  </div>
</Section>
