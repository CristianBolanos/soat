---
/** Así de fácil (#como-funciona): 3 pasos y un CTA que vuelve al cotizador. */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { steps } from '@/data/landing';
---

<Section id="como-funciona" title="Así de fácil: tu SOAT en 3 pasos" tone="surface">
  <ol class="grid gap-4 sm:grid-cols-3">
    {steps.map((step, index) => (
      <li class="rounded-card bg-bg p-5 shadow-card">
        <div class="flex items-center gap-3">
          <span
            class="flex size-10 items-center justify-center rounded-full bg-cta font-extrabold text-on-cta"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <Icon name={step.icon} class="size-5 text-muted" />
        </div>
        <h3 class="mt-3 font-bold">{step.title}</h3>
        <p class="mt-1 text-sm text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="mt-8">
    <Button
      href="#cotizador-pasos"
      variant="cta"
      size="lg"
      icon="simple-icons:whatsapp"
      data-track="cta_click"
      data-track-ubicacion="como_funciona"
    >
      Empezar ahora
    </Button>
  </div>
</Section>
