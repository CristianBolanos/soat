---
/**
 * Hero (#hero): propuesta de valor y cotizador visibles sin scroll en móvil (360×740).
 * Sin imagen (decisión D8): el título en letra vial y la placa amarilla del cotizador
 * son la cara de la marca, y el contenido más grande de la primera pantalla (LCP) es
 * el título, así que no hay imagen que priorizar. La ilustración del chat pasó al cierre.
 * El subtítulo lleva el ancla #beneficios del sitio anterior: resume los mismos beneficios.
 */
import QuoteForm from '@/components/quote/QuoteForm.astro';
import Container from '@/components/ui/Container.astro';
import { site } from '@/config/site';
import { currentYear } from '@/lib/dates';

const year = currentYear(site.timeZone);
---

<section id="hero" aria-labelledby="hero-titulo" class="pt-6 pb-12 sm:pt-12 lg:pb-20">
  <Container class="grid items-start gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
    <div>
      <h1 id="hero-titulo" class="font-display text-display-sm sm:text-display font-bold">
        Tu SOAT {year} para moto o carro, listo hoy por WhatsApp
      </h1>
      <p id="beneficios" class="sm:text-lead lg:text-lead-lg mt-3 max-w-xl text-base text-muted">
        Te confirmamos el valor exacto antes de pagar, te acompaña un asesor real y recibes tu
        póliza electrónica, verificable en el RUNT.
      </p>
    </div>
    <QuoteForm />
  </Container>
</section>
