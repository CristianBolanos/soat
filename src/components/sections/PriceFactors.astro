---
/**
 * ¿Cuánto cuesta? (#tarifas, ancla del sitio anterior). Sin precios (D5): explica
 * de qué depende el valor y lleva al cotizador con el tipo ya elegido.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import { priceSection } from '@/data/landing';
import { MESSAGES, whatsappUrl, withOrigin } from '@/lib/whatsapp';

const otherVehicleHref = whatsappUrl(
  site.contact.whatsapp,
  withOrigin(MESSAGES.otherVehicle, 'web'),
);
---

<Section id="tarifas" title={priceSection.title} intro={priceSection.intro}>
  <ul class="grid gap-4 sm:grid-cols-3">
    {priceSection.factors.map((factor) => (
      <li class="rounded-card border border-line bg-bg p-5">
        <Icon name={factor.icon} class="size-6 text-brand" />
        <h3 class="mt-3 font-bold">{factor.title}</h3>
        <p class="mt-1 text-sm text-muted">{factor.text}</p>
      </li>
    ))}
  </ul>
  <div class="mt-8 grid gap-3 sm:flex">
    <Button href="#cotizador-pasos" variant="cta" size="lg" icon="motorbike" data-preselect="moto">
      Consultar el valor de mi moto
    </Button>
    <Button href="#cotizador-pasos" variant="cta" size="lg" icon="car-front" data-preselect="carro">
      Consultar el valor de mi carro
    </Button>
  </div>
  <p class="mt-4 text-sm">
    <a
      href={otherVehicleHref}
      class="font-semibold text-brand underline underline-offset-2"
      data-track="whatsapp_click"
      data-track-ubicacion="otro_vehiculo"
    >
      ¿Ciclomotor, motocarro u otro vehículo? Escríbenos
    </a>
  </p>
</Section>
