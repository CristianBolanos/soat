---
/**
 * Barra fija en móvil (reemplaza el menú hamburguesa, T8): WhatsApp y llamada
 * siempre a mano. Se oculta mientras el cotizador está en pantalla para no
 * duplicar la acción (scripts/mobile-bar.ts). Sin JavaScript no se muestra.
 */
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { MESSAGES, whatsappUrl, withOrigin } from '@/lib/whatsapp';

const whatsappHref = whatsappUrl(site.contact.whatsapp, withOrigin(MESSAGES.generic, 'web'));
---

<div
  class="invisible fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-bg px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-card transition duration-300 lg:hidden"
  data-mobile-bar
>
  <div class="mx-auto grid max-w-md grid-cols-[1fr_auto] gap-2">
    <Button
      href={whatsappHref}
      variant="whatsapp"
      icon="simple-icons:whatsapp"
      data-track="whatsapp_click"
      data-track-ubicacion="barra_movil"
    >
      Cotizar por WhatsApp
    </Button>
    <Button
      href={`tel:${site.contact.phone}`}
      variant="outline"
      icon="phone"
      aria-label={`Llamar al ${site.contact.phoneDisplay}`}
      data-track="phone_click"
      data-track-ubicacion="barra_movil"
    >
      <!-- Solo ícono en celulares: así «Cotizar por WhatsApp» cabe en una línea desde 360 px. -->
      <span class="max-sm:sr-only">Llamar</span>
    </Button>
  </div>
</div>

<script>
  import '@/scripts/mobile-bar';
</script>
