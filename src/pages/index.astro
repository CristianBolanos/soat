---
// Página provisional (F2): valida la cadena de herramientas. Se reemplaza por la
// landing en F5, después de las compuertas G1 (contenido) y G2 (diseño).
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

const whatsappHref = `https://wa.me/${site.contact.whatsapp}`;
---

<BaseLayout
  title="SOAT YA | Sitio en construcción"
  description="Cotiza tu SOAT de moto o carro por WhatsApp con SOAT YA."
  noindex
>
  <main class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center gap-6 px-4 py-16">
    <h1 class="text-3xl font-extrabold text-balance">SOAT YA: sitio en construcción</h1>
    <p class="text-muted">Mientras tanto, cotiza tu SOAT de moto o carro por WhatsApp.</p>
    <a
      href={whatsappHref}
      class="bg-wa text-on-wa inline-flex min-h-11 items-center justify-center rounded-xl px-6 font-bold"
    >
      Cotizar por WhatsApp
    </a>
  </main>
</BaseLayout>
