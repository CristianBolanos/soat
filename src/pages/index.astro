---
// Landing en construcción por fases: F3 (diseño) trae el header y el hero; las demás
// secciones (¿Cuánto cuesta?, Cómo funciona, Compra segura, FAQ, pie) llegan en F5.
import Header from '@/components/layout/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { currentYear } from '@/lib/dates';

const year = currentYear(site.timeZone);
---

<BaseLayout
  title={`Compra tu SOAT ${year} para moto o carro | SOAT YA`}
  description={`Cotiza y compra tu SOAT ${year} para moto o carro por WhatsApp. Te confirmamos el valor antes de pagar y tu póliza es verificable en el RUNT.`}
>
  <Header />
  <main>
    <Hero />
  </main>
</BaseLayout>
