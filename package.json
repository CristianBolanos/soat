{
  "name": "soat-ya",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing de conversión de SOAT YA: cotiza tu SOAT de moto o carro por WhatsApp.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/**/*.html\" && node scripts/validate-w3c.mjs",
    "lhci": "lhci autorun",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:build && pnpm validate:html"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/utils": "^3.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "html-validate": "^11.16.4",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vnu-jar": "^26.10.12"
  }
}
